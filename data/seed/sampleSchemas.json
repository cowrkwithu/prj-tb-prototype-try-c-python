  {
   "schemaId": "schema-003",
   "name": "환자 삶의 질(QoL) 설문 데이터",
   "description": "결핵 환자의 치료 전후 삶의 질을 종합적으로 평가하는 설문 도구. 신체적, 심리적, 사회적 영역을 포괄하며 표준화된 점수 체계를 사용합니다.",
   "nameEn": "Patient Quality of Life (QoL) Survey Data",
   "descriptionEn": "A survey instrument that comprehensively assesses the quality of life of tuberculosis patients before and after treatment. It covers the physical, psychological, and social domains and uses a standardized scoring system.",
   "category": "survey",
   "version": "2.0",
   "status": "published",
   "visibility": "public",
   "owner": {
    "userId": "user-003",
    "userName": "이임상",
    "userNameEn": "Lee Im-sang",
    "institution": "국립중앙의료원"
   },
   "linkField": {
    "fieldName": "condition_id",
    "displayName": "케이스 ID",
    "description": "환자 케이스 연결 키",
    "displayNameEn": "Case ID",
    "descriptionEn": "Key linking to the patient case"
   },
   "fields": [
    {
     "fieldId": "f-qol-001",
     "fieldName": "survey_date",
     "displayName": "설문 날짜",
     "description": "설문 수행 날짜",
