     "fieldName": "fev1_percent",
     "displayName": "FEV1 예측치 %",
     "description": "FEV1 예측치 대비 실측치 백분율",
     "displayNameEn": "FEV1 % Predicted",
     "descriptionEn": "Measured FEV1 as a percentage of the predicted value",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
      "max": 200,
      "precision": 1,
      "unit": "%"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 6,
     "group": "spirometry"
    },
    {
     "fieldId": "f-pft-007",
     "fieldName": "fev1_fvc_ratio",
     "displayName": "FEV1/FVC 비율",
     "description": "FEV1/FVC 비율 (자동 계산)",
     "displayNameEn": "FEV1/FVC Ratio",
     "descriptionEn": "FEV1/FVC ratio (auto-calculated)",
     "dataType": "CALCULATED",
     "constraints": {
      "formula": "fev1_L / fvc_L * 100",
