  {
   "schemaId": "schema-004",
   "name": "폐기능검사(PFT) 추적 데이터",
   "description": "결핵 치료 전후 폐기능 변화를 추적하는 데이터 구조. 폐활량(spirometry) 및 확산능(DLCO) 검사 결과를 체계적으로 기록합니다.",
   "nameEn": "Pulmonary Function Test (PFT) Tracking Data",
   "descriptionEn": "A data schema for tracking changes in lung function before and after tuberculosis treatment. Systematically records spirometry and diffusing capacity (DLCO) test results.",
   "category": "clinical_ext",
   "version": "1.0",
   "status": "draft",
   "visibility": "private",
   "owner": {
    "userId": "user-004",
    "userName": "최영상",
    "userNameEn": "Choi Young-sang",
    "institution": "서울아산병원"
   },
   "linkField": {
