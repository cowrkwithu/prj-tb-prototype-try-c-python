     "displayNameEn": "FVC % Predicted",
     "descriptionEn": "Measured FVC as a percentage of the predicted value",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
      "max": 200,
      "precision": 1,
      "unit": "%"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 4,
     "group": "spirometry"
    },
    {
     "fieldId": "f-pft-005",
     "fieldName": "fev1_L",
     "displayName": "FEV1 (L)",
     "description": "1초간 노력성 호기량",
     "displayNameEn": "FEV1 (L)",
     "descriptionEn": "Forced expiratory volume in 1 second",
