  {
   "schemaId": "schema-002",
   "name": "Mtb 전사체 발현량 데이터",
   "description": "결핵균(M. tuberculosis) 전사체(transcriptome) 발현량 데이터를 기록하는 데이터 구조. RNA-seq 기반 유전자 발현 분석 결과를 체계적으로 관리합니다.",
   "nameEn": "Mtb Transcriptome Expression Data",
   "descriptionEn": "A data schema for recording M. tuberculosis transcriptome expression data. Systematically manages RNA-seq-based gene expression analysis results.",
   "category": "genomic_ext",
   "version": "1.0",
   "status": "published",
   "visibility": "shared",
   "owner": {
    "userId": "user-002",
    "userName": "박유전",
    "userNameEn": "Park Yu-jeon",
    "institution": "한국생명공학연구원"
   },
   "linkField": {
    "fieldName": "condition_id",
    "displayName": "케이스 ID",
    "description": "환자 케이스 연결 키",
    "displayNameEn": "Case ID",
    "descriptionEn": "Key linking to the patient case"
   },
   "fields": [
    {
     "fieldId": "f-tx-001",
     "fieldName": "sample_id",
     "displayName": "샘플 ID",
     "description": "RNA 추출 샘플 고유 식별자",
     "displayNameEn": "Sample ID",
     "descriptionEn": "Unique identifier of the RNA extraction sample",
     "dataType": "TEXT",
     "constraints": {
      "maxLength": 50
     },
     "isRequired": true,
     "isUnique": true,
     "order": 1,
     "group": "sample_info"
    },
    {
     "fieldId": "f-tx-002",
     "fieldName": "specimen_id",
     "displayName": "검체 ID",
     "description": "원본 검체 식별자 (검사실 데이터 참조)",
     "displayNameEn": "Specimen ID",
     "descriptionEn": "Source specimen identifier (references lab data)",
     "dataType": "REFERENCE",
     "constraints": {
      "refDictionary": "lab",
      "refField": "specimen_type"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 2,
     "group": "sample_info",
     "sourceRef": {
      "dictionaryId": "TB.U.LAB.001.012",
      "fieldId": "TB.U.LAB.001.012",
      "fieldName": "specimen_type",
      "isModified": true
     }
    },
    {
     "fieldId": "f-tx-003",
     "fieldName": "extraction_method",
     "displayName": "RNA 추출 방법",
     "description": "RNA 추출에 사용된 방법",
     "displayNameEn": "RNA Extraction Method",
     "descriptionEn": "Method used for RNA extraction",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "TRIzol",
        "label": "TRIzol"
       },
       {
        "value": "Column-based",
        "label": "Column-based"
       },
       {
        "value": "FFPE",
        "label": "FFPE"
       },
       {
        "value": "Other",
        "label": "Other"
       }
      ]
     },
     "isRequired": true,
     "isUnique": false,
     "order": 3,
     "group": "sample_info"
    },
    {
     "fieldId": "f-tx-004",
     "fieldName": "rna_quality_rin",
     "displayName": "RIN 값",
     "description": "RNA Integrity Number (RNA 품질 지표)",
     "displayNameEn": "RIN Value",
     "descriptionEn": "RNA Integrity Number (RNA quality metric)",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
      "max": 10,
      "precision": 1
     },
     "isRequired": true,
     "isUnique": false,
     "order": 4,
     "group": "sample_info"
    },
    {
     "fieldId": "f-tx-005",
     "fieldName": "sequencing_depth_m",
     "displayName": "시퀀싱 깊이(M reads)",
     "description": "시퀀싱 깊이 (백만 reads 단위)",
     "displayNameEn": "Sequencing Depth (M reads)",
     "descriptionEn": "Sequencing depth (in millions of reads)",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
      "precision": 1,
      "unit": "M reads"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 5,
     "group": "sample_info"
    },
    {
     "fieldId": "f-tx-006",
     "fieldName": "gene_id",
     "displayName": "유전자 ID",
     "description": "M. tuberculosis 유전자 Rv 번호",
     "displayNameEn": "Gene ID",
     "descriptionEn": "M. tuberculosis gene Rv number",
     "dataType": "TEXT",
     "constraints": {
