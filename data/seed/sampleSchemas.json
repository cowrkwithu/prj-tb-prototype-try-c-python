{
 "SAMPLE_SCHEMAS": [
  {
   "schemaId": "schema-001",
   "name": "약물 부작용 추적 데이터",
   "description": "결핵 치료 중 발생하는 약물 부작용을 체계적으로 추적하고 기록하는 데이터 구조. CTCAE v5.0 기준의 등급 분류를 포함합니다.",
   "nameEn": "Adverse Drug Reaction Tracking Data",
   "descriptionEn": "A data schema for systematically tracking and recording adverse drug reactions that occur during tuberculosis treatment. Includes severity grading based on CTCAE v5.0.",
   "category": "clinical_ext",
   "version": "1.2",
   "status": "published",
   "visibility": "public",
   "owner": {
    "userId": "user-001",
    "userName": "김연구",
    "userNameEn": "Kim Yeon-gu",
    "institution": "분당서울대병원"
   },
   "linkField": {
    "fieldName": "condition_id",
    "displayName": "케이스 ID",
    "description": "환자 케이스 연결 키",
    "displayNameEn": "Case ID",
    "descriptionEn": "Key linking to the patient case"
   },
   "fields": [
    {
     "fieldId": "f-ae-001",
     "fieldName": "adverse_event_id",
     "displayName": "부작용 ID",
     "description": "부작용 사례 고유 식별자",
     "displayNameEn": "Adverse Event ID",
     "descriptionEn": "Unique identifier of the adverse event case",
     "dataType": "TEXT",
     "constraints": {
      "maxLength": 50
     },
     "isRequired": true,
     "isUnique": true,
     "order": 1,
     "group": "basic_info"
    },
    {
     "fieldId": "f-ae-002",
     "fieldName": "event_date",
     "displayName": "발생일",
     "description": "부작용이 발생한 날짜",
     "displayNameEn": "Onset Date",
     "descriptionEn": "Date on which the adverse event occurred",
     "dataType": "DATE",
     "constraints": {},
     "isRequired": true,
     "isUnique": false,
     "order": 2,
     "group": "basic_info",
     "sourceRef": {
      "dictionaryId": "TB.U.TX.006.005",
      "fieldId": "TB.U.TX.006.005",
      "fieldName": "treatment_start_date",
      "isModified": true
     }
    },
    {
     "fieldId": "f-ae-003",
     "fieldName": "onset_day",
     "displayName": "발생일(등록일 기준)",
     "description": "등록일 기준 부작용 발생일 (일 수)",
     "displayNameEn": "Onset Day (from Enrollment)",
     "descriptionEn": "Number of days from enrollment to adverse event onset",
     "dataType": "INTEGER",
     "constraints": {
      "min": 0,
      "max": 1000
     },
     "isRequired": false,
     "isUnique": false,
     "order": 3,
     "group": "basic_info"
    },
    {
     "fieldId": "f-ae-004",
     "fieldName": "drug_suspected",
     "displayName": "원인 의심 약물",
     "description": "부작용의 원인으로 의심되는 약물",
     "displayNameEn": "Suspected Drug",
     "descriptionEn": "Drug suspected of causing the adverse event",
     "dataType": "REFERENCE",
     "constraints": {
      "refDictionary": "tx",
      "refField": "treatment"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 4,
     "group": "basic_info"
    },
    {
     "fieldId": "f-ae-005",
     "fieldName": "event_category",
     "displayName": "부작용 분류",
     "description": "부작용의 기관계별 분류",
     "displayNameEn": "Event Category",
     "descriptionEn": "Classification of the adverse event by organ system",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "hepatotoxicity",
        "label": "간독성",
        "labelEn": "Hepatotoxicity"
       },
       {
        "value": "nephrotoxicity",
        "label": "신독성",
        "labelEn": "Nephrotoxicity"
       },
       {
        "value": "ototoxicity",
        "label": "이독성",
        "labelEn": "Ototoxicity"
       },
       {
        "value": "neuropathy",
        "label": "말초신경병증",
        "labelEn": "Peripheral Neuropathy"
       },
       {
        "value": "gi_upset",
        "label": "위장장애",
        "labelEn": "Gastrointestinal Upset"
       },
       {
        "value": "rash",
        "label": "피부발진",
        "labelEn": "Skin Rash"
       },
       {
        "value": "qt_prolongation",
        "label": "QT 연장",
        "labelEn": "QT Prolongation"
       },
       {
        "value": "hematologic",
        "label": "혈액학적",
        "labelEn": "Hematologic"
       },
       {
        "value": "optic_neuritis",
        "label": "시신경염",
        "labelEn": "Optic Neuritis"
       },
       {
        "value": "arthralgia",
        "label": "관절통",
        "labelEn": "Arthralgia"
       },
       {
        "value": "other",
        "label": "기타",
        "labelEn": "Other"
       }
      ]
     },
     "isRequired": true,
     "isUnique": false,
     "order": 5,
     "group": "detail"
    },
    {
     "fieldId": "f-ae-006",
     "fieldName": "severity_grade",
     "displayName": "중증도 등급",
     "description": "CTCAE v5.0 기준 중증도 등급",
     "displayNameEn": "Severity Grade",
     "descriptionEn": "Severity grade per CTCAE v5.0",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "grade1",
        "label": "Grade 1 (경증)",
        "labelEn": "Grade 1 (Mild)"
       },
       {
        "value": "grade2",
        "label": "Grade 2 (중등도)",
        "labelEn": "Grade 2 (Moderate)"
       },
       {
        "value": "grade3",
        "label": "Grade 3 (중증)",
        "labelEn": "Grade 3 (Severe)"
       },
       {
        "value": "grade4",
        "label": "Grade 4 (생명위협)",
        "labelEn": "Grade 4 (Life-threatening)"
       },
       {
        "value": "grade5",
        "label": "Grade 5 (사망)",
        "labelEn": "Grade 5 (Death)"
       }
      ]
     },
     "isRequired": true,
     "isUnique": false,
     "order": 6,
     "group": "detail"
    },
    {
     "fieldId": "f-ae-007",
     "fieldName": "ctcae_code",
     "displayName": "CTCAE 코드",
     "description": "CTCAE v5.0 표준 코드",
     "displayNameEn": "CTCAE Code",
     "descriptionEn": "CTCAE v5.0 standard code",
     "dataType": "CODED",
     "constraints": {
      "codeSystem": "CTCAE v5.0"
     },
     "isRequired": false,
     "isUnique": false,
     "order": 7,
     "group": "detail"
    },
    {
     "fieldId": "f-ae-008",
     "fieldName": "description",
     "displayName": "상세 설명",
     "description": "부작용의 구체적인 증상 및 경과 기술",
     "displayNameEn": "Detailed Description",
     "descriptionEn": "Specific symptoms and clinical course of the adverse event",
     "dataType": "TEXTAREA",
     "constraints": {
      "maxLength": 2000
     },
     "isRequired": false,
     "isUnique": false,
     "order": 8,
     "group": "detail"
    },
    {
     "fieldId": "f-ae-009",
     "fieldName": "action_taken",
     "displayName": "조치 사항",
     "description": "부작용 발생 후 취한 조치",
     "displayNameEn": "Action Taken",
     "descriptionEn": "Action taken in response to the adverse event",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "maintain",
        "label": "용량 유지",
        "labelEn": "Dose Maintained"
       },
       {
        "value": "reduce",
        "label": "용량 감량",
        "labelEn": "Dose Reduced"
       },
       {
        "value": "suspend",
        "label": "일시 중단",
        "labelEn": "Temporarily Interrupted"
       },
       {
        "value": "stop",
        "label": "영구 중단",
        "labelEn": "Permanently Discontinued"
       },
       {
        "value": "change",
        "label": "약물 변경",
        "labelEn": "Drug Switched"
       }
      ]
     },
     "isRequired": true,
     "isUnique": false,
     "order": 9,
     "group": "followup"
    },
    {
     "fieldId": "f-ae-010",
     "fieldName": "outcome",
     "displayName": "전귀",
     "description": "부작용의 최종 전귀",
     "displayNameEn": "Outcome",
     "descriptionEn": "Final outcome of the adverse event",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "recovered",
        "label": "회복",
        "labelEn": "Recovered"
       },
       {
        "value": "recovering",
        "label": "회복 중",
        "labelEn": "Recovering"
       },
       {
        "value": "sequelae",
        "label": "후유증 남음",
        "labelEn": "Recovered with Sequelae"
       },
       {
        "value": "not_recovered",
        "label": "미회복",
        "labelEn": "Not Recovered"
       },
       {
        "value": "death",
        "label": "사망",
        "labelEn": "Death"
       }
      ]
     },
     "isRequired": false,
     "isUnique": false,
     "order": 10,
     "group": "followup"
    },
    {
     "fieldId": "f-ae-011",
     "fieldName": "recovery_days",
     "displayName": "회복 소요일",
     "description": "부작용 발생부터 회복까지 소요 일수",
     "displayNameEn": "Days to Recovery",
     "descriptionEn": "Number of days from onset to recovery",
     "dataType": "INTEGER",
     "constraints": {
      "min": 0
     },
     "isRequired": false,
     "isUnique": false,
     "order": 11,
     "group": "followup"
    },
    {
     "fieldId": "f-ae-012",
     "fieldName": "lab_values",
     "displayName": "관련 검사수치",
     "description": "부작용 관련 검사 수치 기록 (예: ALT, AST, Cr 등)",
     "displayNameEn": "Related Lab Values",
     "descriptionEn": "Lab values related to the adverse event (e.g., ALT, AST, Cr)",
     "dataType": "TEXTAREA",
     "constraints": {
      "maxLength": 1000
     },
     "isRequired": false,
     "isUnique": false,
     "order": 12,
     "group": "followup"
    }
   ],
   "fieldGroups": [
    {
     "groupName": "basic_info",
     "displayName": "부작용 기본정보",
     "displayNameEn": "Adverse Event Basics",
     "order": 1
    },
    {
     "groupName": "detail",
     "displayName": "부작용 상세",
     "displayNameEn": "Adverse Event Details",
     "order": 2
    },
    {
     "groupName": "followup",
     "displayName": "추적 관찰",
     "displayNameEn": "Follow-up",
     "order": 3
    }
   ],
   "validationRules": [
    {
     "ruleId": "rule-ae-001",
     "name": "회복일 검증",
     "nameEn": "Recovery days check",
     "expression": "recovery_days >= 0",
     "message": "회복 소요일은 0 이상이어야 합니다",
     "messageEn": "Days to recovery must be 0 or greater"
    }
   ],
   "createdAt": "2025-09-15",
