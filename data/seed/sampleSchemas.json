     "displayNameEn": "Gene Name",
     "descriptionEn": "Common name of the gene",
     "dataType": "TEXT",
     "constraints": {
      "maxLength": 50
     },
     "isRequired": false,
     "isUnique": false,
     "order": 7,
     "group": "expression"
    },
    {
     "fieldId": "f-tx-008",
     "fieldName": "expression_tpm",
     "displayName": "TPM 발현량",
     "description": "Transcripts Per Million 정규화 발현량",
     "displayNameEn": "TPM Expression",
     "descriptionEn": "Expression level normalized as Transcripts Per Million",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
      "precision": 2,
      "unit": "TPM"
     },
     "isRequired": true,
     "isUnique": false,
     "order": 8,
     "group": "expression"
    },
    {
     "fieldId": "f-tx-009",
     "fieldName": "log2_fold_change",
     "displayName": "log2 FC",
     "description": "log2 변화량 (대조군 대비)",
