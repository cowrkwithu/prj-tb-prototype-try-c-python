     "fieldName": "fvc_L",
     "displayName": "FVC (L)",
     "description": "노력성 폐활량 (Forced Vital Capacity)",
     "displayNameEn": "FVC (L)",
     "descriptionEn": "Forced Vital Capacity",
     "dataType": "DECIMAL",
     "constraints": {
      "min": 0,
