     "descriptionEn": "Point in the course of treatment at which the PFT was performed",
     "dataType": "SELECT",
     "constraints": {
      "options": [
       {
        "value": "pre_treatment",
        "label": "치료 전",
        "labelEn": "Pre-treatment"
       },
       {
        "value": "during_treatment",
        "label": "치료 중",
