 "genomicMetaCsvTemplate": {
  "type": "genomic_meta",
  "requiredColumns": [
   "condition_id",
   "specimen_id",
   "platform",
   "method"
  ],
  "optionalColumns": [
   "coverage",
   "sra_accession",
   "lineage"
  ],
  "sampleData": [
   {
    "condition_id": "TB-KR-051",
    "specimen_id": "SP-001",
    "platform": "Illumina",
    "method": "WGS",
    "coverage": "100",
    "sra_accession": "SRR12345678",
    "lineage": "Beijing"
   },
   {
    "condition_id": "TB-MN-021",
    "specimen_id": "SP-010",
    "platform": "ONT",
    "method": "WGS",
    "coverage": "50",
    "sra_accession": "",
    "lineage": "LAM"
   }
  ],
  "validationRules": {
   "platform": {
    "$expr": "(v) => ['Illumina', 'ONT', 'PacBio', 'Other'].includes(v)"
   },
   "method": {
    "$expr": "(v) => ['WGS', 'Targeted'].includes(v)"
   },
   "coverage": {
    "$expr": "(v) => !isNaN(Number(v)) && Number(v) > 0"
   },
   "sra_accession": {
    "$expr": "(v) => /^(SRR|ERR)\\d+$/.test(v)"
   }
  }
 },
