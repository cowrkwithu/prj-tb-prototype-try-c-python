    "$expr": "(v) => Number.isInteger(Number(v)) && Number(v) >= 0"
   },
   "end_day": {
    "$expr": "(v) => Number.isInteger(Number(v)) && Number(v) > 0"
   },
   "route": {
    "$expr": "(v) => ['Oral', 'Injectable', 'IV'].includes(v)"
   }
  }
